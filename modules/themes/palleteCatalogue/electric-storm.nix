{
  # Electric Storm - bright blue primary with violet secondary, as requested
  name = "electric-storm";
  description = "High-energy theme with electric blue primary and vivid violet secondary";

  # Base background/foreground
  bg       = "#0d0f1a";
  programBg= "#080a14";
  fg       = "#c8d8f8";

  # Accent colors
  primary  = "#1e90ff"; # electric blue
  secondary = "#8b00ff"; # vivid violet
  tertiary = "#00e5ff"; # cyan highlight

  # Semantic intent
  accent   = "#1e90ff";
  danger   = "#ff2d55"; # hot red
  warning  = "#ffcc00"; # bright yellow
  success  = "#39d353"; # electric green
  info     = "#00e5ff"; # cyan

  # Greyscale shades
  black    = "#05060e";
  dark     = "#0d0f1a";
  muted    = "#1e2540";
  light    = "#a0b8e8";
  white    = "#e8f0ff";

  # Transparent versions
  bgTransparent = "rgba(13, 15, 26, 0.85)";
  darkTransparent = "rgba(8, 10, 20, 0.65)";
}
