{
  # Dracula - iconic purple/pink dark theme
  name = "dracula";
  description = "Classic Dracula dark theme with purple, pink and cyan accents";

  # Base background/foreground
  bg       = "#282a36";
  programBg= "#21222c";
  fg       = "#f8f8f2";

  # Accent colors
  primary  = "#bd93f9"; # purple
  secondary = "#ff79c6"; # pink
  tertiary = "#50fa7b"; # green

  # Semantic intent
  accent   = "#bd93f9";
  danger   = "#ff5555"; # red
  warning  = "#ffb86c"; # orange
  success  = "#50fa7b"; # green
  info     = "#8be9fd"; # cyan

  # Greyscale shades
  black    = "#191a21";
  dark     = "#282a36";
  muted    = "#44475a";
  light    = "#f8f8f2";
  white    = "#ffffff";

  # Transparent versions
  bgTransparent = "rgba(40, 42, 54, 0.85)";
  darkTransparent = "rgba(33, 34, 44, 0.65)";
}
