{
  # Solarized Dark - precision-engineered classic
  name = "solarized-dark";
  description = "Ethan Schoonover's precision-engineered dark colour scheme";

  # Base background/foreground
  bg       = "#002b36";
  programBg= "#00212b";
  fg       = "#839496";

  # Accent colors
  primary  = "#268bd2"; # blue
  secondary = "#d33682"; # magenta
  tertiary = "#2aa198"; # cyan

  # Semantic intent
  accent   = "#268bd2";
  danger   = "#dc322f"; # red
  warning  = "#b58900"; # yellow
  success  = "#859900"; # green
  info     = "#2aa198"; # cyan

  # Greyscale shades
  black    = "#001e26";
  dark     = "#002b36";
  muted    = "#073642";
  light    = "#93a1a1";
  white    = "#fdf6e3";

  # Transparent versions
  bgTransparent = "rgba(0, 43, 54, 0.85)";
  darkTransparent = "rgba(7, 54, 66, 0.65)";
}
