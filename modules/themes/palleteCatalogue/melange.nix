{
  # Melange - warm amber-tinted dark theme
  name = "melange";
  description = "Warm amber and dusty rose dark theme with an analog photography feel";

  # Base background/foreground
  bg       = "#2a2520";
  programBg= "#201c18";
  fg       = "#ece1d7";

  # Accent colors
  primary  = "#d4a45c"; # warm amber
  secondary = "#c07a7a"; # dusty rose
  tertiary = "#78997a"; # sage green

  # Semantic intent
  accent   = "#d4a45c";
  danger   = "#b05c5c"; # muted red
  warning  = "#d4a45c"; # amber
  success  = "#78997a"; # sage
  info     = "#7a9ba8"; # slate blue

  # Greyscale shades
  black    = "#14100d";
  dark     = "#2a2520";
  muted    = "#4a4038";
  light    = "#c4b5a5";
  white    = "#ece1d7";

  # Transparent versions
  bgTransparent = "rgba(42, 37, 32, 0.85)";
  darkTransparent = "rgba(32, 28, 24, 0.65)";
}
