{
  # Oxocarbon - IBM Carbon design system dark palette
  name = "oxocarbon";
  description = "IBM Carbon design system-inspired deep cool dark theme";

  # Base background/foreground
  bg       = "#161616";
  programBg= "#0d0d0d";
  fg       = "#f2f4f8";

  # Accent colors
  primary  = "#78a9ff"; # IBM blue 40
  secondary = "#be95ff"; # IBM purple 40
  tertiary = "#3ddbd9"; # IBM teal 40

  # Semantic intent
  accent   = "#78a9ff";
  danger   = "#ff7eb6"; # IBM pink
  warning  = "#f1c21b"; # IBM yellow
  success  = "#42be65"; # IBM green 40
  info     = "#3ddbd9"; # IBM teal

  # Greyscale shades
  black    = "#000000";
  dark     = "#161616";
  muted    = "#393939";
  light    = "#c1c7cd";
  white    = "#ffffff";

  # Transparent versions
  bgTransparent = "rgba(22, 22, 22, 0.88)";
  darkTransparent = "rgba(13, 13, 13, 0.70)";
}
