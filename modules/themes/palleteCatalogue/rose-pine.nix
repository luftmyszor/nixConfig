{
  # Rose Pine - soho vibes, warm dark with dusty rose
  name = "rose-pine";
  description = "All natural pine, faux fur and soho vibes - warm dark with dusty rose";

  # Base background/foreground
  bg       = "#191724";
  programBg= "#1f1d2e";
  fg       = "#e0def4";

  # Accent colors
  primary  = "#c4a7e7"; # iris (purple)
  secondary = "#ebbcba"; # rose
  tertiary = "#9ccfd8"; # foam (teal)

  # Semantic intent
  accent   = "#c4a7e7";
  danger   = "#eb6f92"; # love (red-pink)
  warning  = "#f6c177"; # gold
  success  = "#31748f"; # pine
  info     = "#9ccfd8"; # foam

  # Greyscale shades
  black    = "#111019";
  dark     = "#191724";
  muted    = "#26233a";
  light    = "#6e6a86";
  white    = "#e0def4";

  # Transparent versions
  bgTransparent = "rgba(25, 23, 36, 0.85)";
  darkTransparent = "rgba(31, 29, 46, 0.65)";
}
