{
  # Monokai Pro - the premium monokai experience
  name = "monokai-pro";
  description = "Monokai Pro - refined dark theme with vivid, warm accents";

  # Base background/foreground
  bg       = "#2d2a2e";
  programBg= "#221f22";
  fg       = "#fcfcfa";

  # Accent colors
  primary  = "#78dce8"; # blue/cyan
  secondary = "#ff6188"; # pink/red
  tertiary = "#a9dc76"; # green

  # Semantic intent
  accent   = "#78dce8";
  danger   = "#ff6188"; # pink-red
  warning  = "#ffd866"; # yellow
  success  = "#a9dc76"; # green
  info     = "#78dce8"; # cyan

  # Greyscale shades
  black    = "#19181a";
  dark     = "#2d2a2e";
  muted    = "#403e41";
  light    = "#c1c0c0";
  white    = "#fcfcfa";

  # Transparent versions
  bgTransparent = "rgba(45, 42, 46, 0.85)";
  darkTransparent = "rgba(34, 31, 34, 0.65)";
}
