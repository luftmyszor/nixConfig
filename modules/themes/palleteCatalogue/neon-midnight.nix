{
  # Neon Midnight - synthwave green/magenta on deep purple-black
  name = "neon-midnight";
  description = "Synthwave-inspired neon green and hot magenta on deep purple-black";

  # Base background/foreground
  bg       = "#0e0b1a";
  programBg= "#080611";
  fg       = "#d0c8f0";

  # Accent colors
  primary  = "#00ff88"; # neon green
  secondary = "#ff00cc"; # hot magenta
  tertiary = "#00ccff"; # electric sky

  # Semantic intent
  accent   = "#00ff88";
  danger   = "#ff2255"; # neon red
  warning  = "#ffdd00"; # neon yellow
  success  = "#00ff88"; # neon green
  info     = "#00ccff"; # electric sky

  # Greyscale shades
  black    = "#05030f";
  dark     = "#0e0b1a";
  muted    = "#221c3d";
  light    = "#9088c0";
  white    = "#e8e0ff";

  # Transparent versions
  bgTransparent = "rgba(14, 11, 26, 0.88)";
  darkTransparent = "rgba(8, 6, 17, 0.70)";
}
