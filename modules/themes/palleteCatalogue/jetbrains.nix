{
  # JetBrains - inspired by JetBrains IDE dark UI (Darcula / New UI vibes)
  name = "jetbrains";
  description = "JetBrains-inspired dark theme (Darcula-like) with blue accent and warm highlights";

  # Base background/foreground
  bg = "#2b2b2b"; # main IDE background
  programBg = "#1f1f1f"; # slightly darker for terminals/panels
  fg = "#a9b7c6"; # typical JetBrains editor foreground

  # Accent colors
  primary = "#3574f0"; # JetBrains-ish blue accent
  secondary = "#b99bf8"; # soft purple highlight
  tertiary = "#6aab73"; # green (success-ish)

  # Semantic intent
  accent = "#3574f0";
  danger = "#ff5647"; # bright red/orange error
  warning = "#ffc66d"; # warm amber (common in JB themes)
  success = "#6aab73"; # green
  info = "#56a8f5"; # cyan/blue info

  # Greyscale shades
  black = "#1e1e1e";
  dark = "#2b2b2b";
  muted = "#3c3f41"; # common JB UI gray (panels/selection)
  light = "#c9d1d9";
  white = "#ffffff";

  # Transparent versions
  bgTransparent = "rgba(43, 43, 43, 0.8)";
  darkTransparent = "rgba(31, 31, 31, 0.6)";
}
