{
  # Kanagawa - muted Japanese ink painting palette
  name = "kanagawa";
  description = "Muted, elegant palette inspired by Katsushika Hokusai's Great Wave";

  # Base background/foreground
  bg       = "#1f1f28";
  programBg= "#16161d";
  fg       = "#dcd7ba";

  # Accent colors
  primary  = "#7e9cd8"; # crystal blue
  secondary = "#957fb8"; # oni violet
  tertiary = "#6a9589"; # wave teal

  # Semantic intent
  accent   = "#7e9cd8";
  danger   = "#c34043"; # autumnal red
  warning  = "#dca561"; # samurai gold
  success  = "#76946a"; # spring green
  info     = "#6a9589"; # wave teal

  # Greyscale shades
  black    = "#090618";
  dark     = "#1f1f28";
  muted    = "#363646";
  light    = "#c8c093";
  white    = "#dcd7ba";

  # Transparent versions
  bgTransparent = "rgba(31, 31, 40, 0.85)";
  darkTransparent = "rgba(22, 22, 29, 0.65)";
}
