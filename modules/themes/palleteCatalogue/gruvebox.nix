{
  # Gruvbox - warm, retro-inspired color scheme
  name = "gruvbox";
  description = "Warm, retro-inspired theme with earthy tones";

  # Base background/foreground
  bg       = "#282828";
  programBg= "#1d2021";
  fg       = "#ebdbb2";

  # Accent colors
  primary  = "#fe8019"; # orange
  secondary = "#d3869b"; # pink
  tertiary = "#8ec07c"; # green

  # Semantic intent
  accent   = "#fe8019";
  danger   = "#fb4934"; # red
  warning  = "#fabd2f"; # yellow
  success  = "#b8bb26"; # green
  info     = "#83a598"; # blue

  # Greyscale shades
  black    = "#1d2021";
  dark     = "#282828";
  muted    = "#665c54";
  light    = "#d5c4a1";
  white    = "#fbf1c7";

  # Transparent versions
  bgTransparent = "rgba(40, 40, 40, 0.8)";
  darkTransparent = "rgba(29, 32, 33, 0.6)";
}
