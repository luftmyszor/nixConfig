{
  # Everforest - green-based, warm and cozy theme
  name = "everforest";
  description = "Green-based warm and cozy theme with forest colors";

  # Base background/foreground
  bg       = "#2d353b";
  programBg= "#232a2e";
  fg       = "#d3c6aa";

  # Accent colors
  primary  = "#a7c080"; # green
  secondary = "#e69875"; # orange
  tertiary = "#7fbbb3"; # teal

  # Semantic intent
  accent   = "#a7c080";
  danger   = "#e67e80"; # red
  warning  = "#dbbc7f"; # yellow
  success  = "#a7c080"; # green
  info     = "#7fbbb3"; # teal

  # Greyscale shades
  black    = "#232a2e";
  dark     = "#2d353b";
  muted    = "#475258";
  light    = "#d3c6aa";
  white    = "#f0f0f0";

  # Transparent versions
  bgTransparent = "rgba(45, 53, 59, 0.8)";
  darkTransparent = "rgba(35, 42, 46, 0.6)";
}
