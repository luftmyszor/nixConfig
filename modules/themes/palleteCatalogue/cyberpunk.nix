{
  # Cyberpunk - neon city nights on near-black
  name = "cyberpunk";
  description = "Neon-drenched cyberpunk aesthetic - yellow/cyan on near-black";

  # Base background/foreground
  bg       = "#0a0a0f";
  programBg= "#050508";
  fg       = "#e2e2e2";

  # Accent colors
  primary  = "#f9f002"; # neon yellow
  secondary = "#00fff9"; # neon cyan
  tertiary = "#ff00a0"; # neon magenta

  # Semantic intent
  accent   = "#f9f002";
  danger   = "#ff003c"; # red
  warning  = "#f9f002"; # yellow
  success  = "#39ff14"; # neon green
  info     = "#00fff9"; # cyan

  # Greyscale shades
  black    = "#000000";
  dark     = "#0a0a0f";
  muted    = "#1a1a2e";
  light    = "#9090a0";
  white    = "#f0f0f8";

  # Transparent versions
  bgTransparent = "rgba(10, 10, 15, 0.88)";
  darkTransparent = "rgba(5, 5, 8, 0.70)";
}
