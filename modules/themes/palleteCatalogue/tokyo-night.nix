{
  # Tokyo Night - clean, dark theme inspired by Tokyo at night
  name = "tokyo-night";
  description = "Clean, vibrant theme inspired by Tokyo at night";

  # Base background/foreground
  bg       = "#1a1b26";
  programBg= "#16161e";
  fg       = "#c0caf5";

  # Accent colors
  primary  = "#7aa2f7"; # blue
  secondary = "#bb9af7"; # purple
  tertiary = "#73daca"; # teal

  # Semantic intent
  accent   = "#7aa2f7";
  danger   = "#f7768e"; # red
  warning  = "#e0af68"; # yellow
  success  = "#9ece6a"; # green
  info     = "#7dcfff"; # cyan

  # Greyscale shades
  black    = "#15161e";
  dark     = "#1a1b26";
  muted    = "#343b58";
  light    = "#a9b1d6";
  white    = "#ffffff";

  # Transparent versions
  bgTransparent = "rgba(26, 27, 38, 0.8)";
  darkTransparent = "rgba(22, 22, 30, 0.6)";
}
