{
  # Nord - arctic, north-bluish color palette
  name = "nord";
  description = "Arctic, north-bluish clean and elegant theme";

  # Base background/foreground
  bg       = "#2e3440";
  programBg= "#3b4252";
  fg       = "#d8dee9";

  # Accent colors
  primary  = "#88c0d0"; # frost
  secondary = "#81a1c1"; # blue
  tertiary = "#a3be8c"; # green

  # Semantic intent
  accent   = "#88c0d0";
  danger   = "#bf616a"; # aurora red
  warning  = "#ebcb8b"; # aurora yellow
  success  = "#a3be8c"; # aurora green
  info     = "#5e81ac"; # blue

  # Greyscale shades
  black    = "#242831";
  dark     = "#2e3440";
  muted    = "#4c566a";
  light    = "#e5e9f0";
  white    = "#eceff4";

  # Transparent versions
  bgTransparent = "rgba(46, 52, 64, 0.8)";
  darkTransparent = "rgba(59, 66, 82, 0.6)";
}
